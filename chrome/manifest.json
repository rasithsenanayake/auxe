{
  "manifest_version": 3,
  "name": "Auxe Companion",
  "version": "0.1.7",
  "minimum_chrome_version": "116",
  "description": "Choose separate playback outputs for Chrome tabs and installed YouTube Music.",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Enable Auxe for this tab"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      }
    }
  },
  "options_page": "devices.html",
  "key": ""
}
